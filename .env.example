# GitHub Credentials
GITHUB_TOKEN=your_personal_access_token_here
GITHUB_CLIENT_ID=your_oauth_client_id
GITHUB_CLIENT_SECRET=your_oauth_client_secret

# AI Credentials
GROQ_API_KEY=your_groq_api_key_here
# Optional: Model name (Default: llama-3.3-70b-versatile)
# Alternative supported models: openai/gpt-oss-120b, qwen/qwen3.8-27b, llama-3.1-8b-instant
GROQ_MODEL=llama-3.3-70b-versatile

# App Config
LOG_LEVEL=INFO
DEBUG=True
PORT=7860
HOST=0.0.0.0
GRADIO_SHARE=False
